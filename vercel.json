{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/news/downloads",
      "destination": "/news/downloads/index.html"
    },
    {
      "source": "/news/downloads/",
      "destination": "/news/downloads/index.html"
    },
    {
      "source": "/backoffice",
      "destination": "/backoffice.html"
    },
    {
      "source": "/backoffice/",
      "destination": "/backoffice.html"
    },
    {
      "source": "/platform/admin",
      "destination": "/backoffice.html"
    },
    {
      "source": "/platform/admin/",
      "destination": "/backoffice.html"
    },
    {
      "source": "/news",
      "destination": "/api/news"
    },
    {
      "source": "/news/",
      "destination": "/api/news"
    },
    {
      "source": "/news/:slug([a-z0-9-]+)",
      "destination": "/api/news?slug=:slug"
    },
    {
      "source": "/news/:slug([a-z0-9-]+)/",
      "destination": "/api/news?slug=:slug"
    },
    {
      "source": "/Fobi/records",
      "destination": "/Fobi/records/index.html"
    },
    {
      "source": "/Fobi/records/",
      "destination": "/Fobi/records/index.html"
    },
    {
      "source": "/Fobi",
      "destination": "/Fobi/index.html"
    },
    {
      "source": "/Fobi/",
      "destination": "/Fobi/index.html"
    },
    {
      "source": "/fobi",
      "destination": "/Fobi/index.html"
    },
    {
      "source": "/platform",
      "destination": "/platform/index.html"
    },
    {
      "source": "/platform/organizers",
      "destination": "/platform/organizers/index.html"
    },
    {
      "source": "/platform/sponsors",
      "destination": "/platform/sponsors/index.html"
    },
    {
      "source": "/platform/media",
      "destination": "/platform/media/index.html"
    },
    {
      "source": "/platform/tickets",
      "destination": "/platform/tickets/index.html"
    },
    {
      "source": "/platform/recruitment",
      "destination": "/platform/recruitment/index.html"
    },
    {
      "source": "/platform/training",
      "destination": "/platform/training/index.html"
    },
    {
      "source": "/platform/member",
      "destination": "/platform/member/index.html"
    },
    {
      "source": "/platform/training/stage",
      "destination": "/platform/training/stage/index.html"
    },
    {
      "source": "/platform/training/camera",
      "destination": "/platform/training/camera/index.html"
    },
    {
      "source": "/platform/training/media",
      "destination": "/platform/training/media/index.html"
    },
    {
      "source": "/party",
      "destination": "/party.html"
    },
    {
      "source": "/party/",
      "destination": "/party.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pageant.self.com.tw"
        }
      ],
      "destination": "/platform",
      "statusCode": 307
    },
    {
      "source": "/",
      "destination": "/Fobi",
      "statusCode": 307
    },
    {
      "source": "/checkout.html",
      "destination": "/Fobi?notice=event-ended",
      "statusCode": 307
    },
    {
      "source": "/tickets.html",
      "destination": "/Fobi?notice=event-ended",
      "statusCode": 307
    },
    {
      "source": "/sponsors.html",
      "destination": "/Fobi?notice=event-ended",
      "statusCode": 307
    },
    {
      "source": "/event.html",
      "destination": "/Fobi?notice=event-ended",
      "statusCode": 307
    },
    {
      "source": "/pageants.html",
      "destination": "/platform/recruitment",
      "statusCode": 307
    },
    {
      "source": "/Fobi/news",
      "destination": "/news",
      "statusCode": 307
    },
    {
      "source": "/Fobi/news/:slug",
      "destination": "/news/:slug",
      "statusCode": 307
    },
    {
      "source": "/news/index.html",
      "destination": "/news",
      "statusCode": 308
    },
    {
      "source": "/news/:slug/index.html",
      "destination": "/news/:slug",
      "statusCode": 308
    },
    {
      "source": "/platform/admin/index.html",
      "destination": "/backoffice",
      "statusCode": 307
    },
    {
      "source": "/admin.html",
      "has": [
        {
          "type": "host",
          "value": "pageant.self.com.tw"
        }
      ],
      "destination": "/backoffice",
      "statusCode": 307
    }
  ],
  "headers": [
    {
      "source": "/backoffice(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
